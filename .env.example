# ─────────────────────────────────────────────────────────────────────────────
# OneUco environment variables — copy this file to `.env.local` and fill in.
# NEVER commit real values. Set the same variables in Vercel
# (Project -> Settings -> Environment Variables) for the deployed app.
# ─────────────────────────────────────────────────────────────────────────────

# From: Supabase Dashboard -> your project -> Settings -> API -> "Project URL"
# Public — safe to expose in the browser (data is protected by RLS policies).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# From: Supabase Dashboard -> Settings -> API -> "anon / public" key
# Public — safe to expose in the browser (data is protected by RLS policies).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# From: Supabase Dashboard -> Settings -> API -> "service_role" key
# SERVER ONLY. Bypasses RLS — used by admin/review server actions.
# Never import this in client code, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From: Google Cloud Console -> APIs & Services -> Credentials ->
# your OAuth 2.0 Client ID (type: Web application).
# Also paste this ID + secret into Supabase: Authentication -> Providers ->
# Google (Supabase performs the OAuth flow; these are kept here for reference
# and for any direct Google integrations added later).
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# From: the same Google Cloud OAuth client. SERVER ONLY — never expose.
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# From: your email provider (used ONLY for the forgot-password email OTP).
# Example: Resend — sign up at resend.com -> API Keys -> create key.
# (OneUco has no login OTP and no SMS OTP; email OTP exists only in the
# forgot-password flow.)
RESEND_API_KEY=re_your-email-provider-key

# From-address for transactional mail (forgot-password OTP, notices).
# Must be a domain/address verified with the email provider above.
EMAIL_FROM="OneUco <no-reply@your-domain.example>"
